#!/bin/sh

set -e # Exit immediately if a command exits with a non-zero status.
set -u # Treat unset variables as an error.

# Check if OpenVPN is enabled by looking for the flag file
if [ ! -f /config/openvpn/.enabled ]; then
    echo "OpenVPN is not enabled. Exiting."
    exit 0
fi

# Check if the config file exists
if [ ! -f /config/openvpn/config.ovpn ]; then
    echo "OpenVPN configuration file not found at /config/openvpn/config.ovpn"
    exit 1
fi

echo "Starting OpenVPN..."
exec /usr/sbin/openvpn --config /config/openvpn/config.ovpn --script-security 2
